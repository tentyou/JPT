<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <!-- Evidence files can contain customer data and must not leave the device. -->
        <exclude domain="file" path="photos" />
        <exclude domain="file" path="pdfs" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="photos" />
        <exclude domain="file" path="pdfs" />
    </device-transfer>
</data-extraction-rules>